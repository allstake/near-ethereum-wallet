{
  "name": "near-ethereum-wallet",
  "version": "0.0.3",
  "description": "Near Ethereum Wallet",
  "keywords": [
    "near",
    "ethereum",
    "wallet",
    "web3",
    "crypto",
    "blockchain"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
