    "prettier": "prettier '{src,test}/**/*.ts' '*.mjs' --write --list-different",
    "prepare": "husky",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/big.js": "^6.2.2",
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.15.17",
    "eslint": "^9.26.0",
    "eslint-js": "github:eslint/js",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "unbuild": "^3.5.0",
    "vite-plugin-node-polyfills": "^0.23.0"
  },
  "peerDependencies": {
    "@wagmi/core": "^2.17.2"
  },
  "dependencies": {
    "@wagmi/core": "^2.17.2",
    "big.js": "^7.0.1",
    "bn.js": "^5.2.2",
